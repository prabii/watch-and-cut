# Copy to backend/.env.local and fill in what you use. Never commit real keys.
# Users can also paste their own key in the app (Model settings); it is sent per request only.

# Gemma 4 / Gemini (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it

# Claude (Anthropic)
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace (starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=

# Any OpenAI-compatible API (OpenAI, OpenRouter, Groq, Together, LM Studio…)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Offline: local Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b

PORT=8787
